{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finanças",
  "mainBinaryName": "financas-local",
  "version": "2.0.0",
  "identifier": "br.com.fernandoandrade.financaslocal",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "Fernando Andrade",
    "category": "Finance",
    "shortDescription": "Controle financeiro no seu computador",
    "longDescription": "Contas, cartões, faturas, contas fixas e lembretes. Os dados ficam só no seu computador.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  }
}
